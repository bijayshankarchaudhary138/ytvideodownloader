{
  "name": "ytvideodownloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ad-free, self-hostable YouTube downloader with real 4K+audio merging, live progress, playlists, subtitles and a free API.",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "setup": "node scripts/setup-binaries.mjs",
    "icons": "node scripts/make-icons.mjs",
    "sitemap": "node scripts/make-sitemap.mjs",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/src/index.js",
    "dev": "node scripts/dev.mjs",
    "tunnel": "npx -y cloudflared tunnel --url http://localhost:8080",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:unit": "vitest run --config vitest.config.js tests/unit tests/api",
    "test:api": "vitest run --config vitest.config.js tests/api",
    "test:e2e": "vitest run --config vitest.config.js tests/e2e tests/web",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
